# Zentoralo Backend - Umgebungsvariablen
# Diese Datei zeigt, welche Werte in Render als Environment Variables hinterlegt werden
# muessen. Niemals echte Secrets in dieses Beispiel-File eintragen oder committen.

# Von Render Postgres automatisch bereitgestellt, sobald die DB verknuepft ist
DATABASE_URL=

# Server
PORT=3000
SESSION_SECRET=change-me

# Anthropic (KI-Rechnungsextraktion, Allergen-Vorschlaege, Chatbot) - Phase 1+
ANTHROPIC_API_KEY=

# Google OAuth (Gmail readonly + Drive.file) - Phase 1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.zentoralo.com/auth/google/callback

# Google Drive Ablage-Ordnername - siehe Sicherheitshinweis in DEPLOYMENT.md,
# niemals leichtfertig aendern sobald Kundendaten existieren
DRIVE_ROOT_FOLDER_NAME=Zentoralo Rechnungen

# CORS - erlaubte Frontend-Origin
FRONTEND_ORIGIN=https://zentoralo.com
